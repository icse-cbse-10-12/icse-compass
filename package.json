{
  "name": "icse-compass",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "imports": { "#lib/*": "./src/lib/*" },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:catalogue": "node scripts/validate-catalogue.mjs"
  },
  "dependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.18.6",
    "@vite-pwa/sveltekit": "^2.0.2",
    "fast-glob": "^3.3.3",
    "magicast": "^0.5.5",
    "svelte-check": "^4.3.2",
    "typescript": "^6.0.0",
    "vite": "^8.0.12",
    "vitest": "^5.1.0"
  }
}
