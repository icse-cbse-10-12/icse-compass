  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^22.18.6",
    "@vite-pwa/sveltekit": "^0.3.0",
    "svelte-check": "^4.3.2",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^3.2.4"
  }
